{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "dist",
    "strict": true,
    "strictPropertyInitialization": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "types": ["node"],
    "jsx": "preserve",
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["electron/**/*", "darkSwap-client-core/src/**/*"],
  "exclude": ["node_modules", "renderer", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
